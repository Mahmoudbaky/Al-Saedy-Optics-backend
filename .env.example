# ---- Server -------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_NAME="Al-Saedy Optics"
# Public URL of this API (used by Better Auth for callbacks / cookies)
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-char-minimum-random-secret
# Comma separated list of browser origins (admin panel) allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Expo app scheme(s) from app.json, comma separated
MOBILE_APP_SCHEMES=alsaedyoptics://

# ---- Database (Neon) ----------------------------------------------------
# Pooled connection for the app
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection for drizzle-kit migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Email (OTP / notifications) ----------------------------------------
# Leave SMTP_HOST empty in development to log emails to the console instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password
EMAIL_FROM="Al-Saedy Optics <no-reply@alsaedyoptics.com>"

# ---- Uploads (UploadThing) ----------------------------------------------
UPLOADTHING_TOKEN=

# ---- Commerce -----------------------------------------------------------
CURRENCY=IQD
# Delivery fee in IQD for home delivery
DELIVERY_FEE=5000
# Orders above this subtotal (IQD) ship for free
FREE_DELIVERY_THRESHOLD=100000

# ---- Clinic (eye exam booking) ------------------------------------------
CLINIC_OPEN_HOUR=10
CLINIC_CLOSE_HOUR=20
CLINIC_SLOT_MINUTES=30
CLINIC_TIMEZONE=Asia/Baghdad
