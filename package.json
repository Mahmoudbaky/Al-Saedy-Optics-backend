{
  "name": "al-saedy-optics-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Al-Saedy Optics mobile app and admin panel",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "auth:generate": "auth generate --config src/lib/auth.ts --output src/db/schema/auth.generated.ts -y",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "vercel-build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.4",
    "better-auth": "^1.7.4",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "auth": "^1.7.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
